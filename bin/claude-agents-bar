#!/bin/bash
#
# claude-agents-bar — entrypoint for the SwiftBar plugin's lifecycle.
#
# Installed by Homebrew as $HOMEBREW_PREFIX/bin/claude-agents-bar (a
# symlink into libexec/bin/). Also works from a git clone.
#
# Subcommands:
#   setup      Wire the plugin + hook into SwiftBar / ~/.claude/.
#   teardown   Undo setup. Sidecar files under ~/.claude/ are preserved.
#   doctor     Check runtime deps (jq, python3, SwiftBar.app).
#   usage      Refresh the subscription-usage snapshot now (debugging).
#   version    Print version.
#   help       This message.

set -euo pipefail

# Follow symlinks so HERE always points at the real directory where
# setup.sh / teardown.sh live, not at the Homebrew bin/ shim dir.
# macOS readlink lacks -f, so we walk the chain manually.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
HERE="$(cd -P "$(dirname "$SOURCE")" >/dev/null && pwd)"

VERSION="1.5.0"

case "${1:-help}" in
    setup)
        shift
        exec bash "$HERE/install/setup.sh" "$@"
        ;;
    teardown)
        shift
        exec bash "$HERE/install/teardown.sh" "$@"
        ;;
    usage|usage-fetch|--usage-fetch)
        # Run the get_usage fetch in the foreground and show what landed.
        # The plugin does this detached every few minutes; this is the
        # by-hand version for "why are the usage lines empty?".
        # `set -e` would abort before we could report a failed fetch, so
        # capture the code instead of letting it propagate.
        rc=0
        /usr/bin/python3 "$HERE/../claude-agents.5s.py" --usage-fetch || rc=$?
        if [ -f "${HOME}/.claude/agent-state.usage" ]; then
            echo "snapshot: $(cat "${HOME}/.claude/agent-state.usage")"
            echo "(record_ts  five_used  five_resets_at  seven_used  seven_resets_at)"
        else
            echo "no snapshot written — see docs/troubleshooting.md" >&2
        fi
        exit $rc
        ;;
    version|--version|-v)
        echo "claude-agents-bar $VERSION"
        ;;
    doctor)
        # Two-layer doctor: shell-level checks for the binaries setup.sh
        # itself relies on, then a Python pass for the deeper "is the
        # plugin actually wired up?" checks that only the plugin knows
        # how to perform (hook registration, TSV freshness, SwiftBar
        # plugin symlink, sidecar permissions, editor .app).
        any_missing=0
        if command -v jq >/dev/null; then
            echo "[ok]   jq        $(command -v jq)"
        else
            echo "[err]  jq        MISSING (brew install jq)"
            any_missing=1
        fi
        if command -v python3 >/dev/null; then
            echo "[ok]   python3   $(command -v python3)"
        else
            echo "[err]  python3   MISSING"
            any_missing=1
        fi
        if [ -d /Applications/SwiftBar.app ]; then
            echo "[ok]   SwiftBar  /Applications/SwiftBar.app"
        else
            echo "[err]  SwiftBar  MISSING (brew install --cask swiftbar)"
            any_missing=1
        fi
        # Only run the in-plugin checks when we have a usable Python; the
        # plugin imports stdlib that an older interpreter might not have.
        if [ "$any_missing" -eq 0 ] && [ -f "$HERE/../claude-agents.5s.py" ]; then
            /usr/bin/python3 "$HERE/../claude-agents.5s.py" --doctor
        fi
        ;;
    help|--help|-h)
        cat <<EOF
usage: claude-agents-bar <command>

Commands:
  setup     Symlink plugin + hook, merge ~/.claude/settings.json (backup first)
  teardown  Undo setup. Sidecar files under ~/.claude/ are preserved.
  doctor    Check runtime deps (jq, python3, SwiftBar.app).
  usage     Refresh the subscription-usage snapshot now (debugging).
  version   Print version.
  help      This message.

Docs: https://github.com/alexey-krylov/ClaudeAgentsBar
EOF
        ;;
    *)
        echo "unknown command: $1 (try: claude-agents-bar help)" >&2
        exit 1
        ;;
esac
